    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/gcc-debug/MCU_LED_1.30.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "HC32F460xE",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            // "serverpath": ,
            "gdbPath": "arm-none-eabi-gdb"
        }
    ]
}